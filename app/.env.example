# Salin ke .env lalu isi. .env TIDAK di-commit (berisi rahasia).

# ---------------- Database (main process)
# Connection string MongoDB Atlas. Dibaca saat dev, dan ditanam ke aplikasi
# saat `yarn electron:build` (lihat src/controllers/dbConfig.js).
MONGO_URI=mongodb://<user>:<password>@<host1>,<host2>,<host3>/sustainabledb_atlas?tls=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority

# ---------------- Cloudinary (main process)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_PRESET=

# ---------------- STS Photo Finish (opsional, main process)
# PF_API_URL=http://<ip-laptop-photofinish>:4100
# PF_DEVICE_TOKEN=
# PF_HMAC_SECRET=

# ---------------- Renderer (VUE_APP_* ikut ke bundle UI — JANGAN isi rahasia)
VUE_APP_ENV=
VUE_APP_BASE_URL=
VUE_APP_RT_URL=
VUE_APP_ACCESS_KEY=
